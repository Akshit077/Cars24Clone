                      },
                      {
                        "type": "text",
                        "props": { "text": "₹4.85 Lakh", "variant": "price" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "rail-sedan",
        "type": "section",
        "props": { "title": "Sedans near you" },
        "visibleIf": { "path": "state.selectedCategory", "eq": "sedan" },
        "children": [
          {
            "type": "carousel",
            "style": { "paddingH": "space.md", "gap": "space.md" },
            "props": { "itemWidth": 240 },
            "children": [
              {
                "type": "card",
                "style": { "background": "color.surface", "corner": "radius.md" },
                "actions": [{ "type": "navigate", "url": "sdui://car/city-2020" }],
                "children": [
                  {
                    "type": "image",
                    "props": {
                      "url": "https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=800",
                      "aspectRatio": "4:3"
                    }
                  },
                  {
                    "type": "column",
                    "style": { "padding": "space.sm", "gap": "space.xs" },
                    "children": [
                      {
                        "type": "text",
                        "props": { "text": "2020 Honda City ZX", "variant": "body" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "31,200 km · Petrol · Auto", "variant": "caption" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "₹9.10 Lakh", "variant": "price" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "finance",
        "type": "card",
        "style": {
          "padding": "space.md",
          "paddingH": "space.md",
          "background": "color.surface",
          "corner": "radius.md"
        },
        "children": [
          {
            "type": "column",
            "style": { "gap": "space.sm", "paddingH": "space.md" },
            "children": [
              {
                "type": "text",
                "props": { "text": "Car loan EMI", "variant": "title" }
              },
              {
                "type": "text",
                "props": {
                  "text": "For a ₹4.85 Lakh Swift. Change tenure — EMI updates from the payload lookup, not app code.",
                  "variant": "caption"
                }
              },
              {
                "type": "text",
                "bind": { "text": "lookups.emiByTenure[state.tenureMonths]" },
                "props": { "text": "₹4,599/mo", "variant": "price" }
              },
              {
                "type": "row",
                "style": { "gap": "space.sm" },
                "children": [
                  {
                    "type": "chip",
                    "props": { "text": "12 mo", "value": 12 },
                    "bind": { "selected": "state.tenureMonths" },
                    "actions": [{ "type": "setState", "path": "tenureMonths", "value": 12 }]
                  },
                  {
                    "type": "chip",
                    "props": { "text": "24 mo", "value": 24 },
                    "bind": { "selected": "state.tenureMonths" },
                    "actions": [{ "type": "setState", "path": "tenureMonths", "value": 24 }]
                  },
                  {
                    "type": "chip",
                    "props": { "text": "36 mo", "value": 36 },
                    "bind": { "selected": "state.tenureMonths" },
                    "actions": [{ "type": "setState", "path": "tenureMonths", "value": 36 }]
                  }
                ]
              },
              {
                "type": "button",
                "props": { "text": "Check eligibility", "variant": "primary" },
                "actions": [{ "type": "openSheet", "id": "loanSheet" }]
              }
            ]
          }
        ]
      },
      {
        "id": "trust",
        "type": "section",
        "props": { "title": "Why buy from Cars24" },
        "children": [
          {
            "type": "grid",
            "style": { "paddingH": "space.md", "gap": "space.sm" },
            "props": { "columns": 2 },
            "children": [
              {
                "type": "card",
                "style": { "padding": "space.md", "background": "color.surface", "corner": "radius.md" },
                "children": [
                  {
                    "type": "text",
                    "props": { "text": "140+ quality checks", "variant": "body" }
                  },
                  {
                    "type": "text",
                    "props": { "text": "Every car inspected before listing", "variant": "caption" }
                  }
                ]
              },
              {
                "type": "card",
                "style": { "padding": "space.md", "background": "color.surface", "corner": "radius.md" },
                "children": [
                  {
                    "type": "text",
                    "props": { "text": "7-day return", "variant": "body" }
                  },
                  {
                    "type": "text",
                    "props": { "text": "Change your mind, return the car", "variant": "caption" }
                  }
                ]
              },
              {
                "type": "card",
                "style": { "padding": "space.md", "background": "color.surface", "corner": "radius.md" },
                "children": [
                  {
                    "type": "text",
                    "props": { "text": "1-year warranty", "variant": "body" }
                  },
                  {
                    "type": "text",
                    "props": { "text": "Cover on major aggregates", "variant": "caption" }
                  }
                ]
              },
              {
                "type": "card",
                "style": { "padding": "space.md", "background": "color.surface", "corner": "radius.md" },
                "children": [
                  {
                    "type": "text",
                    "props": { "text": "Fixed price", "variant": "body" }
                  },
                  {
                    "type": "text",
                    "props": { "text": "No haggling at the hub", "variant": "caption" }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "footer-cta",
        "type": "column",
        "style": { "padding": "space.md", "gap": "space.sm" },
        "children": [
          {
            "type": "button",
            "props": { "text": "Sell your car", "variant": "secondary" },
            "actions": [{ "type": "navigate", "url": "sdui://sell" }]
          }
        ]
      }
    ]
  }
}

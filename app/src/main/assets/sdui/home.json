                      "url": "https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=800",
                      "aspectRatio": "4:3"
                    }
                  },
                  {
                    "type": "column",
                    "style": { "padding": "space.sm", "gap": "space.xs" },
                    "children": [
                      {
                        "type": "text",
                        "props": { "text": "2020 Honda City ZX", "variant": "body" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "31,200 km · Petrol · Auto", "variant": "caption" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "₹9.10 Lakh", "variant": "price" }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "rail-suv",
        "type": "section",
        "props": { "title": "SUVs near you" },
        "visibleIf": { "path": "state.selectedCategory", "eq": "suv" },
        "children": [
          {
            "type": "carousel",
            "style": { "paddingH": "space.md", "gap": "space.md" },
            "props": { "itemWidth": 240 },
            "children": [
              {
                "type": "card",
                "style": { "background": "color.surface", "corner": "radius.md" },
                "actions": [{ "type": "navigate", "url": "sdui://car/creta-2021" }],
                "children": [
                  {
                    "type": "image",
                    "props": {
                      "url": "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=800",
                      "aspectRatio": "4:3"
                    }
                  },
                  {
                    "type": "column",
                    "style": { "padding": "space.sm", "gap": "space.xs" },
                    "children": [
                      {
                        "type": "text",

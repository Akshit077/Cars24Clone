{
  "schemaVersion": 1,
  "minClientVersion": 1,
  "screen": {
    "id": "home",
    "title": "Cars24"
  },
  "state": {
    "selectedCategory": "all",
    "tenureMonths": 24
  },
  "lookups": {
    "emiByTenure": {
      "12": "₹8,499/mo",
      "24": "₹4,599/mo",
      "36": "₹3,299/mo"
    }
  },
  "sheets": {
    "loanSheet": {
      "type": "column",
      "style": { "padding": "space.lg", "gap": "space.md" },
      "children": [
        {
          "type": "text",
          "props": { "text": "Check loan eligibility", "variant": "title" }
        },
        {
          "type": "text",
          "props": {
            "text": "Share a few details. We will show offers from our partner lenders. EMI updates when you change tenure on the home strip.",
            "variant": "body"
          }
        },
        {
          "type": "text",
          "bind": { "text": "lookups.emiByTenure[state.tenureMonths]" },
          "props": { "text": "₹4,599/mo", "variant": "price" }
        },
        {
          "type": "button",
          "props": { "text": "Continue", "variant": "primary" },
          "actions": [{ "type": "closeSheet" }]
        }
      ]
    }
  },
  "root": {
    "type": "column",
    "style": { "background": "color.bg", "gap": "space.lg" },
    "children": [
      {
        "id": "header",
        "type": "row",
        "style": { "paddingH": "space.md", "paddingV": "space.sm", "gap": "space.sm" },
        "children": [
          {
            "type": "icon",
            "props": { "name": "location" }
          },
          {
            "type": "column",
            "style": { "gap": "space.xs" },
            "children": [
              {
                "type": "text",
                "props": { "text": "Delivering to", "variant": "caption" }
              },
              {
                "type": "text",
                "props": { "text": "Gurugram, 122001", "variant": "body" }
              }
            ]
          }
        ]
      },
      {
        "id": "search",
        "type": "search",
        "style": { "paddingH": "space.md" },
        "props": { "placeholder": "Search for your dream car" },
        "actions": [{ "type": "navigate", "url": "sdui://search" }]
      },
      {
        "id": "banners",
        "type": "carousel",
        "style": { "paddingH": "space.md", "gap": "space.sm" },
        "props": { "itemWidth": 320 },
        "children": [
          {
            "type": "card",
            "style": { "corner": "radius.md" },
            "actions": [{ "type": "navigate", "url": "sdui://campaign/zero-down" }],
            "children": [
              {
                "type": "image",
                "props": {
                  "url": "https://images.unsplash.com/photo-1485291571150-772bcfc10da5?w=1200",
                  "aspectRatio": "16:9"
                }
              }
            ]
          },
          {
            "type": "card",
            "style": { "corner": "radius.md" },
            "actions": [{ "type": "navigate", "url": "sdui://sell" }],
            "children": [
              {
                "type": "image",
                "props": {
                  "url": "https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=1200",
                  "aspectRatio": "16:9"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "categories",
        "type": "carousel",
        "style": { "paddingH": "space.md", "gap": "space.sm" },
        "props": { "itemWidth": 108 },
        "children": [
          {
            "type": "chip",
            "props": { "text": "All cars", "value": "all" },
            "bind": { "selected": "state.selectedCategory" },
            "actions": [{ "type": "setState", "path": "selectedCategory", "value": "all" }]
          },
          {
            "type": "chip",
            "props": { "text": "SUV", "value": "suv" },
            "bind": { "selected": "state.selectedCategory" },
            "actions": [{ "type": "setState", "path": "selectedCategory", "value": "suv" }]
          },
          {
            "type": "chip",
            "props": { "text": "Hatchback", "value": "hatch" },
            "bind": { "selected": "state.selectedCategory" },
            "actions": [{ "type": "setState", "path": "selectedCategory", "value": "hatch" }]
          },
          {
            "type": "chip",
            "props": { "text": "Sedan", "value": "sedan" },
            "bind": { "selected": "state.selectedCategory" },
            "actions": [{ "type": "setState", "path": "selectedCategory", "value": "sedan" }]
          }
        ]
      },
      {
        "id": "rail-all",
        "type": "section",
        "props": { "title": "Cars for you" },
        "visibleIf": { "path": "state.selectedCategory", "eq": "all" },
        "children": [
          {
            "type": "carousel",
            "style": { "paddingH": "space.md", "gap": "space.md" },
            "props": { "itemWidth": 240 },
            "children": [
              {
                "type": "card",
                "style": { "background": "color.surface", "corner": "radius.md" },
                "actions": [{ "type": "navigate", "url": "sdui://car/swift-2019" }],
                "children": [
                  {
                    "type": "image",
                    "props": {
                      "url": "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?w=800",
                      "aspectRatio": "4:3"
                    }
                  },
                  {
                    "type": "column",
                    "style": { "padding": "space.sm", "gap": "space.xs" },
                    "children": [
                      {
                        "type": "text",
                        "props": { "text": "2019 Maruti Swift VXI", "variant": "body" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "42,000 km · Petrol · Manual", "variant": "caption" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "₹4.85 Lakh", "variant": "price" }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "card",
                "style": { "background": "color.surface", "corner": "radius.md" },
                "actions": [{ "type": "navigate", "url": "sdui://car/creta-2021" }],
                "children": [
                  {
                    "type": "image",
                    "props": {
                      "url": "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=800",
                      "aspectRatio": "4:3"
                    }
                  },
                  {
                    "type": "column",
                    "style": { "padding": "space.sm", "gap": "space.xs" },
                    "children": [
                      {
                        "type": "text",
                        "props": { "text": "2021 Hyundai Creta SX", "variant": "body" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "28,400 km · Diesel · Auto", "variant": "caption" }
                      },
                      {
                        "type": "text",
                        "props": { "text": "₹12.40 Lakh", "variant": "price" }
                      }
                    ]
                  }
